# --- Xcode project ---
# Macrowavers.xcodeproj is committed and uses synced folders. Only per-user state stays out
# (xcuserdata/ and *.xcuserstate below).

# --- Xcode build output ---
build/
DerivedData/
*.xcuserstate
xcuserdata/

# --- Local, per-developer settings (never shared) ---
Configs/Local.xcconfig

# --- Signing material (never in git) ---
*.mobileprovision
*.provisionprofile
*.p12
*.cer
*.certSigningRequest

# --- Blender backups ---
*.blend1
*.blend2

# --- macOS ---
.DS_Store
._*
